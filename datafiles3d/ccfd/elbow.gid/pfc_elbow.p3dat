new
set fish autocreate off

domain extent -2 0.1 -0.1 0.1 -0.1 1.01 condition destroy destroy destroy
cmat default model linear property kn 1e6 dp_nratio 0.2

wall import filename wall.stl

ball generate n 700 box -1.9 -0.5 -0.05 0.05 -0.05 0.05 rad 0.002 0.003 range cylinder end1 -1.9 0 0 end2 -0.5 0 0 rad 0.045

ball attr dens 2e3
ball attr xvelocity 18

config cfd
cfd buoyancy off
cfd interval 10


cfd connect density 1.189 viscosity 1.835e-5
cfd slave
