new
set fish autocreate off
set deterministic off

domain extent -0.01 1.1e-2 -0.01 1.1e-2 -0.01 0.06
cmat default model linear property kn 1e6 dp_nratio 0.2 fric 0.1

def inline
  global dim = 9.5174e-3
  global radius = dim / 3 / 5 / 2
  global xdim = dim - radius
  global ydim = 2 * dim - radius
end
@inline
set grav 0 0 -9.81

ball generate cubic box @radius @xdim @radius @xdim  ...
    [radius + 7 * 0.05 / 26] [xdim + radius + 7 * 0.05 / 26] ...
    rad @radius

wall generate box 0 @dim 0 @dim [7 * 0.05 / 26] 0.06

ball attr density 2465

ball attr radius [0.95 * radius]

def ball_height
  local min = 7 * 0.05 / 26
  local max = 0
  loop foreach local b ball.list
    if ball.pos.z(b) > max then
      max = ball.pos.z(b)
    endif
  endloop
  ball_height = max - min
end

def fluid_time
  global fluid_time = cfd.age
end


history add id 1 fish @ball_height nstep 10000
history add id 2 fish @fluid_time
plot add hist 1 vs 2
plot add ball

config cfd
cfd porosity poly
cfd buoy on
cfd interval 5000

cfd connect density 998.23 viscosity 1.004e-3

cfd slave
