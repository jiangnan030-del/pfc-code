new
set fish autocreate off

domain extent -5 5 -5 5 -5 5
set gravity 0 0 -9.8
set timestep max 1e-5

ball create rad 0.0005 position-x 0.001 position-y 0.001 position-z .801 id 1
ball attribute density 2650

def fluid_time
  global fluid_time = mech.age
end

ball history id 1 zvelocity id 1
history add id 2 fish @fluid_time
plot add hist 1 vs 2
plot add cfdelement shape arrow colorby vectorattribute "velocity"

config cfd
cfd buoyancy on
cfd connect density 1000 viscosity 1.004e-3
cfd slave

def print_results
  local uz = ball.vel.z(ball.find(1))
  local oo = io.out(string.build("Ball velocity %1", uz))
end
@print_results

plot bitmap filename "drop2.png"
