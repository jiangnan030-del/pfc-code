;def exact
; oo=out('exact ' + String (200^(1/3.)))
;end

def func ;drag function
  func = (0.5 * (0.63 + 4.8/sqrt(2.0*rhof*r*x/muf))^2*rhof*pi*r^2*x^2) - (rhop-rhof)*9.8*4.0/3.0*pi*r^3
end

def funcd ; derivative 
  funcd = (0.25 * 0.63^2 * rhof*pi*r^2*x^2 + 3./4. * 0.63 * 4.8 * sqrt(rhof) * pi * r^(3./2.) * sqrt(x)/(sqrt(2/muf)) + 4.8^2*muf*pi*r/2.)
end

def stokes
 oo=out('stokes velocity: ' + String (2./9.*9.8*r^2*(rhop-rhof)/muf))
end

def rep
 oo=out('Particle Reynolds number Re_p: ' + String (2*r*rhof*x/muf))
end



def nr_safe
;     see numerical recipes in c -- rtsafe()
;     hybrid bisection / newton rhapson root finder.
;     written in FISH for your enjoyment.
  x=x1
  fl = func
  df = funcd
  x=x2
  fh = func
  df =  funcd
  if fl > 0.0 then
    if fh > 0.0 then
      error='Root must be bracketed'
    end_if
  end_if
  if fl < 0.0 then
    if fh < 0.0 then
      error='Root must be bracketed'
    end_if
  end_if


  if fl = 0.0 then
    nr_safe = fl
    exit
  end_if
  if fh = 0.0 then
    nr_safe = fh
    exit
  end_if
  if fl < 0.0 then
    xl=x1
    xh=x2
  else
    xh=x1
    xl=x2
  end_if 
  rts = 0.5 * (x1+x2)
  dxold=abs(x2-x1)
  dx=dxold
  x=rts
  f=func
  fd=funcd
  loop j (1, maxit)
    if ((rts-xh)*df-f)*((rts-xl)*df-f) > 0 then 
      dxold=dx
      dx=0.5*(xh-xl)
      rts=xl+dx
      if xl = rts then 
        nr_safe=rts
        exit
      end_if
    else
      if abs(2*f) > abs(dxold*df) then
      else
        dxold=dx
        dx=f/df
        temp=rts
        rts=rts-dx
        if temp=rts then
          nr_safe = rts
          exit
        end_if
      end_if
    end_if

    if abs(dx) < TOL then
      oo=out('u_x = '+ String(rts))
      nr_safe = rts
      exit
    end_if
    x = rts
    f = func
    fd = funcd
    if f < 0.0 then
      xl=rts
    else
      xh=rts
    end_if
  end_loop
  error='max iterations exceeded'
end

;newton
def inline
  rhof = 1260.
  rhop = 2500.
  muf = 1.5
  r=0.005
  x1=0.0001
  x2=0.08
end
inline

nr_safe
stokes
rep


