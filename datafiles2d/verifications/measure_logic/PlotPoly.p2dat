; fname: PlotPoly.p2dat
; ============================================================================
;
restore PolydisperseAssembly

; Creates a view of the granular packing and of the measurement circles
plot create view PolyAssembly
plot add ball value
plot add wall value
plot add domain
plot add measure value

; Plot the porosity measurement error vs the dimension of the measurement circle
plot create view PolyPlot
plot current view PolyPlot
plot clear
plot add table ... 
xaxis log on label "Porosity computation error [%]" ...
yaxis label "Measurement Sphere Diameter" ...
charttitle size 25 text "Porosity Measurements on a polydisperse assembly" on ...
marks size 18 on ...
seriescaption size 44 on ...
rangecaption on ...
title size 55 text "Porosity Measurements" on ...
position 1 7 size 98 92 ...
1 style mark name "Polydisperse" markstyle size 2 type plus color skyblue