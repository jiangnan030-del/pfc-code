; fname: PlotRegular.p2dat
; ============================================================================
;
restore RegularAssembly

; Creates a view of the granular packing and of the measurement circles
plot create view RegularAssembly
plot current view RegularAssembly
plot clear
plot add ball value
plot add measure value ...
title size 55 text "Measurement Circles Radii" on
;plot manual

; Plot the porosity measurement error vs the dimension of the measurement circle
plot create view Error
plot current view Error
plot clear
plot add table ... 
xaxis log on label "Porosity computation error [%]" ...
yaxis label "Measurement Circle Diameter" ...
charttitle size 25 text "Porosity Measurements on regular assemblies" on ...
marks size 18 on ...
seriescaption size 44 on ...
rangecaption on ...
title size 55 text "Porosity Measurements" on ...
position 1 7 size 98 92 ...
1 style mark name "1 cubic_lores" markstyle size 2 type plus color skyblue ...
2 style mark name "2 cubic_hires" markstyle size 2 type plus color green ...
3 style mark name "3 hexa_lores" markstyle size 2 type plus color red ...
4 style mark name "4 hexa_hires" markstyle size 2 type plus color cyan
;plot manual